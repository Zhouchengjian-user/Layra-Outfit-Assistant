# ---- 生产登录（邀请码与密钥只配在部署平台）----
ENV=dev
INVITE_CODES=replace_with_high_entropy_invite_codes
SESSION_SECRET=replace_with_at_least_32_random_characters
# 身份映射密钥要与 SESSION_SECRET 不同，且上线后不要轮换，否则用户会被映射到新衣柜。
OWNER_ID_SECRET=replace_with_a_separate_32_character_random_secret

# ---- 可选错误监控（DSN 留空时完全不发送；不配置源码上传令牌）----
# 镜像构建前设置可同时启用浏览器端；仅在运行时设置仍会启用服务端监控。
SENTRY_DSN=

# ---- veFaaS 轻量生产模式（本地开发无需设置）----
# SQLITE_PATH=/tmp/data/yida.sqlite
# SQLITE_BACKUP_INTERVAL_MS=300000
# SQLITE_BACKUP_DEBOUNCE_MS=10000

# 阿里云百炼（华北 2 / 北京）
# 请勿在这里填写真实密钥；复制本文件为 .env.local 后再填写。
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3-vl-flash

# 高清白底商品图生成
DASHSCOPE_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_PRODUCT_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_PRODUCT_IMAGE_SIZE=1536*1536
# 穿着照中被人体遮挡的衣物补全；qwen-image-2.0 优先保证速度，可切 wan2.7-image 优先平铺效果。
DASHSCOPE_GARMENT_RECONSTRUCTION_MODEL=qwen-image-2.0
DASHSCOPE_GARMENT_RECONSTRUCTION_SIZE=1024*1024
DASHSCOPE_GARMENT_RECONSTRUCTION_CANDIDATES=2

# ---- 可选：ComfyUI 本地衣物抠图 ----
# aliyun：保持云端抠图；comfyui：只使用本地 BiRefNet；hybrid：本地优先、失败自动回退云端。
CUTOUT_PROVIDER=aliyun
COMFYUI_BASE_URL=
COMFYUI_BIREFNET_MODEL=birefnet.safetensors
COMFYUI_TIMEOUT_MS=12000
# 仅远程 ComfyUI 网关需要；本机服务请留空。
COMFYUI_API_KEY=

# ---- 火山方舟（视觉识别备用 + Seedream 图像生成）----
ARK_API_KEY=replace_with_your_ark_api_key
# 可选：填写当前账号已开通的视觉模型 ID 或推理接入点 ID 后，才启用 DashScope 失败自动降级。
ARK_VISION_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_IMAGE_SIZE=1920x1920
# 阿里云欠费或鉴权失败时，衣物补全自动降级到此模型；留空则复用上面两项。
ARK_GARMENT_RECONSTRUCTION_MODEL=
ARK_GARMENT_RECONSTRUCTION_SIZE=
# 第一张未通过完整性检查时才生成第二张，可设为 1 或 2。
ARK_GARMENT_RECONSTRUCTION_CANDIDATES=2

# ---- 可选：火山引擎 MySQL（设置 MYSQL_HOST 后才切换；轻量生产模式请留空）----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=replace_with_your_mysql_user
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=yida
MYSQL_POOL_SIZE=3

# ---- 火山引擎 TOS（生产必须配置 Bucket，并绑定最小权限 veFaaS Role）----
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_BUCKET=

# 仅供本地直连 TOS；生产函数使用请求级 Role STS，不配置长期 AK/SK。
TOS_ACCESS_KEY_ID=replace_with_your_tos_access_key_id
TOS_ACCESS_KEY_SECRET=replace_with_your_tos_access_key_secret
TOS_SESSION_TOKEN=
